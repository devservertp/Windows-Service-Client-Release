# ====== APP API SETTING ======

HOST_VERSION=0.0.2
HOST_FROM_PREFIX=tp-net-agent

# ====== LISTENING ======

HOST_PORT=1882

# ====== MQTT SERVICE ======

MQTT_SERVER_HOST=127.0.0.1
MQTT_SERVER_PORT=1881

MQTT_OPT_USERNAME=
MQTT_OPT_PASSWORD=

MQTT_INIT_MAX_FAIL_TO_REBOOT=180

# PUB CHANNEL (CommandHandler/Modules) Only need Host id

MQTT_RUNTIME_TOPIC=winwtsvc/:hostId/runtime
MQTT_PROFILE_TOPIC=winwtsvc/:hostId/profile
MQTT_HEALTH_TOPIC=winwtsvc/:hostId/health
MQTT_SENSOR_TOPIC=winwtsvc/:hostId/sensor
MQTT_SYSTEM_TOPIC=winwtsvc/:hostId/system
MQTT_SIGNAL_TOPIC=winwtsvc/:hostId/signal

# SUB CHANNEL (Services/Facade/MqttService.java) Need all From pre fix + host id + hwid  (host idetify)

MQTT_CONTROL_TOPIC=winatsvc/:hostFromPrefix-:hostId-:hostHwid/control

# SIGNAL KEY ON MESSAGE MQTT

MQTT_SIGNAL_TARGET_KEY=agent:facade::hostId

# ====== POOL WORKER ======

POOL_WORKER_COUNT=8
POOL_WORKER_PREFIX=worker
POOL_WORKER_PREFIX_THREAD_NAME=thread

# ====== SENSOR WEBSERVER (libre_sensor_module — port 1886) ======

SENSOR_WEBSERVER_HOST=http://127.0.0.1:1886
SENSOR_WEBSERVER_HEARTBEAT_PATH=/api/heartbeat
SENSOR_WEBSERVER_SNAPSHOT_PATH=/api/sensor/snapshot
SENSOR_WEBSERVER_MOTHERBOARD_PATH=/api/sensor/motherboard
SENSOR_WEBSERVER_CPU_PATH=/api/sensor/cpu
SENSOR_WEBSERVER_GPU_PATH=/api/sensor/gpu
SENSOR_WEBSERVER_MEMORY_PATH=/api/sensor/memory
SENSOR_WEBSERVER_STORAGE_PATH=/api/sensor/storage
SENSOR_WEBSERVER_NETWORK_PATH=/api/sensor/network
SENSOR_WEBSERVER_BATTERY_PATH=/api/sensor/battery
SENSOR_WEBSERVER_CONTROLLER_PATH=/api/sensor/controller
SENSOR_WEBSERVER_PSU_PATH=/api/sensor/psu
SENSOR_WEBSERVER_OTHER_PATH=/api/sensor/other
SENSOR_WEBSERVER_TEMPERATURE_PATH=/api/sensor/temperature
SENSOR_WEBSERVER_LOAD_PATH=/api/sensor/load
SENSOR_WEBSERVER_INFO_PATH=/api/sensor/info
SENSOR_WEBSERVER_RAW_PATH=/api/sensor/snapshot
SENSOR_MAX_FAIL_TO_REBOOT=10

# ====== HARDWARE WEBSERVER (wmi_hardware_module — port 1885) ======

HARDWARE_WEBSERVER_HOST=http://127.0.0.1:1885
HARDWARE_NOTIFY_PORT=1882
HARDWARE_WEBSERVER_HASH_PATH=/api/hash

# Hardware paths
HARDWARE_WEBSERVER_SNAPSHOT_PATH=/api/hardware/snapshot
HARDWARE_WEBSERVER_MOTHERBOARD_PATH=/api/hardware/motherboard
HARDWARE_WEBSERVER_CPU_PATH=/api/hardware/cpu
HARDWARE_WEBSERVER_GPU_PATH=/api/hardware/gpu
HARDWARE_WEBSERVER_MEMORY_PATH=/api/hardware/memory
HARDWARE_WEBSERVER_STORAGE_PATH=/api/hardware/storage
HARDWARE_WEBSERVER_NETWORK_PATH=/api/hardware/network
HARDWARE_WEBSERVER_PSU_PATH=/api/hardware/psu
HARDWARE_WEBSERVER_OTHER_PATH=/api/hardware/other

# Registry paths
HARDWARE_WEBSERVER_REGISTRY_SNAPSHOT_PATH=/api/registry/snapshot
HARDWARE_WEBSERVER_REGISTRY_OS_PATH=/api/registry/os
HARDWARE_WEBSERVER_REGISTRY_REMOTE_PATH=/api/registry/remote
HARDWARE_WEBSERVER_REGISTRY_FIREWALL_PATH=/api/registry/firewall
HARDWARE_WEBSERVER_REGISTRY_STARTUP_PATH=/api/registry/startup
HARDWARE_WEBSERVER_REGISTRY_SHUTDOWN_PATH=/api/registry/shutdown

# Property paths
HARDWARE_WEBSERVER_PROPERTY_SNAPSHOT_PATH=/api/property/snapshot
HARDWARE_WEBSERVER_PROPERTY_MAC_PATH=/api/property/mac
HARDWARE_WEBSERVER_PROPERTY_NETWORK_PATH=/api/property/network
HARDWARE_WEBSERVER_PROPERTY_RDP_PATH=/api/property/rdp
HARDWARE_WEBSERVER_PROPERTY_IP_ADDRESS_PATH=/api/property/ip-address
HARDWARE_WEBSERVER_PROPERTY_GATEWAY_PATH=/api/property/gateway
HARDWARE_WEBSERVER_PROPERTY_DNS_PATH=/api/property/dns
HARDWARE_WEBSERVER_PROPERTY_EVENT_LOG_PATH=/api/property/event-log


# ====== HEALTH NETWORK ======

HEALTH_NETWORK_PING_COUNT=6
HEALTH_NETWORK_TARGETS=8.8.8.8

# ====== WALLPAPER ======

WALLPAPER_URL=https://github.com/devservertp/tp-net-client-wallpaper-store
