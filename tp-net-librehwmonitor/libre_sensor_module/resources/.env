# =============================================================
#  WebSync / LibreHW  —  Runtime Configuration
# =============================================================
#
#  API Routes  (tên route phải khai báo ở đây trước khi dùng trong Program.cs)
#  ----------
ROUTE_RAW=raw
ROUTE_HEARTBEAT=heartbeat
ROUTE_CPU_TEMPERATURE=cpu-temperature
ROUTE_CPU_LOAD=cpu-load
ROUTE_NETWORK=network
ROUTE_INIT=init
#

# -------------------------------------------------------------
#  Webserver
# -------------------------------------------------------------

# Địa chỉ IP lắng nghe (127.0.0.1 = localhost only)
HOST=127.0.0.1

# Cổng HTTP
PORT=1886

# -------------------------------------------------------------
#  Heartbeat Service
# -------------------------------------------------------------

# Chu kỳ làm mới dữ liệu sensor cho /api/heartbeat (ms)
# Mặc định: 12000 (12 giây)
REFRESH_INTERVAL=12000

# -------------------------------------------------------------
#  Dynamic Pool
#
#  Tạo/renew job:   GET /api/<ttlMs>/<intervalMs>/<module>?metrics=cpu,gpu,...
#                   → trả { key, data }
#
#  Peek cache:      GET /api/cache/<ttlMs>.<intervalMs>.<module>.<metrics>
#                   → trả data, không renew TTL
#
#  Stop all:        GET /api/pool/stop
# -------------------------------------------------------------

# Khoảng cách tối thiểu giữa các lần poll (ms)
# Quá nhỏ sẽ gây tải liên tục lên sensor
POOL_MIN_INTERVAL_MS=1000

# TTL tối thiểu của một job (ms)
# Phải đủ lớn để job chạy ít nhất POOL_MIN_TTL_CYCLES chu kỳ
POOL_MIN_TTL_MS=10000

# TTL tối đa của một job (ms) — mặc định 1 tiếng
POOL_MAX_TTL_MS=3600000

# TTL phải >= intervalMs * N (tránh tạo job rồi hủy ngay)
POOL_MIN_TTL_CYCLES=3

# Số lượng pool job tối đa chạy đồng thời
POOL_MAX_JOBS=10
