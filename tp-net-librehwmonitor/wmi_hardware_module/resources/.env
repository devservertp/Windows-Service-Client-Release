# =============================================================
#  WebSync / HardwareModule  —  Runtime Configuration
# =============================================================
#
#  API Routes  (tên route phải khai báo ở đây trước khi dùng trong Program.cs)
#  ----------
ROUTE_HASH_HARDWARE=hash-hardware
ROUTE_HASH_NETWORK=hash-network

ROUTE_HARDWARE_SNAPSHOT=hardware-snapshot
ROUTE_NETWORK_SNAPSHOT=network-snapshot

ROUTE_MAC=mac

ROUTE_MOTHERBOARD=motherboard
ROUTE_CPU=cpu
ROUTE_GPU=gpu
ROUTE_MEMORY=memory
ROUTE_STORAGE=storage
ROUTE_NETWORK=network
ROUTE_BATTERY=battery
ROUTE_PSU=psu
ROUTE_OTHER=other

ROUTE_NETWORK_PROPS=network-properties
ROUTE_REMOTE_PROPS=remote-properties
ROUTE_REGISTRY_PROPS=registry-properties
ROUTE_EVENT_LOG=event-log
#

# -------------------------------------------------------------
#  Event Log
# -------------------------------------------------------------

# Số entry tối đa mỗi log (System + Application)
EVENT_LOG_MAX_ENTRIES=100

# -------------------------------------------------------------
#  RDP Port Scanner
# -------------------------------------------------------------

# Khoảng cách giữa mỗi lần rà (ms)
RDP_SCAN_INTERVAL_MS=12000

# Số tick rà trước khi dừng (4 tiếng)
RDP_SCAN_TICKS=1200

# -------------------------------------------------------------
#  Webserver
# -------------------------------------------------------------

# Địa chỉ IP lắng nghe (127.0.0.1 = localhost only)
HOST=127.0.0.1
PORT=1885

# -------------------------------------------------------------
#  Hardware Change Detection
# -------------------------------------------------------------

# Đường dẫn lưu file snapshot (relative to exe)
HARDWARE_SNAPSHOT_PATH=data/hardware_snapshot.json
NETWORK_SNAPSHOT_PATH=data/network_snapshot.json

# Host:port nhận thông báo khi phát hiện thay đổi phần cứng
NOTIFY_HOST=127.0.0.1
NOTIFY_PORT=1882

# Endpoint nhận POST khi có thay đổi
NOTIFY_PATH_HARDWARE=/api/hardware-changed
NOTIFY_PATH_NETWORK=/api/network-changed
NOTIFY_PATH_RDP=/api/rdp-changed
NOTIFY_PATH_NETWORK_PROPS=/api/network-properties-changed

# -------------------------------------------------------------
#  Network Properties Scanner
# -------------------------------------------------------------

# Khoảng cách giữa mỗi lần rà (ms)
NETWORK_SCAN_INTERVAL_MS=30000
