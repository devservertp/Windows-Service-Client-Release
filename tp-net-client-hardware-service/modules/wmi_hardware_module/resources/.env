# =============================================================
#  WMI Hardware Module — Runtime Configuration
# =============================================================

# -------------------------------------------------------------
#  Webserver
# -------------------------------------------------------------
HOST=127.0.0.1
PORT=1885

# -------------------------------------------------------------
#  Notify Target
# -------------------------------------------------------------
TARGET_NOTIFY_SEND_HOST=127.0.0.1
TARGET_NOTIFY_SEND_PORT=1882

# -------------------------------------------------------------
#  Hash
# -------------------------------------------------------------
HASH_DIR=data/hash
HASH_FILE_PREFIX=_
HASH_NOTIFY_HOST=
HASH_NOTIFY_PORT=
HASH_NOTIFY_BASE_PATH=/api/notify
HASH_RETRY_MAX=30
HASH_RETRY_DELAY_MS=12000
HASH_FAIL_DIR=data/fail.hash_difference
HASH_FAIL_FILE_PREFIX=fail.hash_difference.

# -------------------------------------------------------------
#  Scan Interval
# -------------------------------------------------------------
PROPERTY_TICKING_SCAN_MS=60000

# -------------------------------------------------------------
#  API Routes — Hardware
# -------------------------------------------------------------
API_HARDWARE_MOTHERBOARD=hardware/motherboard
API_HARDWARE_CPU=hardware/cpu
API_HARDWARE_GPU=hardware/gpu
API_HARDWARE_MEMORY=hardware/memory
API_HARDWARE_STORAGE=hardware/storage
API_HARDWARE_NETWORK=hardware/network
API_HARDWARE_PSU=hardware/psu
API_HARDWARE_OTHER=hardware/other

# -------------------------------------------------------------
#  API Routes — Registry
# -------------------------------------------------------------
API_REGISTRY_OS=registry/os
API_REGISTRY_REMOTE=registry/remote
API_REGISTRY_FIREWALL=registry/firewall
API_REGISTRY_STARTUP=registry/startup
API_REGISTRY_SHUTDOWN=registry/shutdown

# -------------------------------------------------------------
#  API Routes — Property
# -------------------------------------------------------------
API_PROPERTY_MAC=property/mac
API_PROPERTY_NETWORK=property/network
API_PROPERTY_RDP=property/rdp
API_PROPERTY_IP_ADDRESS=property/ip-address
API_PROPERTY_GATEWAY=property/gateway
API_PROPERTY_DNS=property/dns
API_PROPERTY_EVENT_LOG=property/event-log

# -------------------------------------------------------------
#  Event Log
# -------------------------------------------------------------
EVENT_LOG_MAX_ENTRIES=100
