# =============================================================
#  Libre Sensor Module — Runtime Configuration
# =============================================================

# -------------------------------------------------------------
#  Webserver
# -------------------------------------------------------------
HOST=127.0.0.1
PORT=1886

# -------------------------------------------------------------
#  Heartbeat
# -------------------------------------------------------------
REFRESH_INTERVAL=12000

# -------------------------------------------------------------
#  Dynamic Pool
# -------------------------------------------------------------
POOL_MIN_INTERVAL_MS=1000
POOL_MIN_TTL_MS=10000
POOL_MAX_TTL_MS=3600000
POOL_MIN_TTL_CYCLES=3
POOL_MAX_JOBS=10

# -------------------------------------------------------------
#  API Routes — Sensor Snapshot
# -------------------------------------------------------------
API_SENSOR_SNAPSHOT=sensor/snapshot

# -------------------------------------------------------------
#  API Routes — Sensor (per hardware)
# -------------------------------------------------------------
API_SENSOR_MOTHERBOARD=sensor/motherboard
API_SENSOR_CPU=sensor/cpu
API_SENSOR_GPU=sensor/gpu
API_SENSOR_MEMORY=sensor/memory
API_SENSOR_STORAGE=sensor/storage
API_SENSOR_NETWORK=sensor/network
API_SENSOR_BATTERY=sensor/battery
API_SENSOR_CONTROLLER=sensor/controller
API_SENSOR_PSU=sensor/psu
API_SENSOR_OTHER=sensor/other

# -------------------------------------------------------------
#  API Routes — Misc
# -------------------------------------------------------------
API_HEARTBEAT=heartbeat
API_SENSOR_TEMPERATURE=sensor/temperature
API_SENSOR_LOAD=sensor/load
API_SENSOR_INFO=sensor/info
